# ==============================================================================
# ZAYNAHS ECOSYSTEM — ENVIRONMENT TEMPLATE (.env.example)
# ==============================================================================

APP_ENV=development
ECOSYSTEM_ID=zaynahs-ecosystem-master-001
ECOSYSTEM_NAME="Zaynahs Ecosystem"
DATABASE_NAME=zaynahs_local.db

BACKUP_ENCRYPTION_KEY=your_aes256_passphrase_here
LOCAL_AUTH_SALT=your_auth_salt_here

# Supabase
SUPABASE_PROJECT_REF=your_supabase_project_ref
SUPABASE_MGMT_TOKEN=sbp_your_management_token
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
SUPABASE_BUCKET_BACKUPS=zaynahs-backups
SUPABASE_BUCKET_MEDIA=zaynahs-media

# Cloudflare
CLOUDFLARE_ZONE_ID=your_cloudflare_zone_id
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
SIGNALING_WORKER_URL=wss://your-worker.workers.dev/ws

# WebRTC STUN
STUN_SERVER_PRIMARY=stun:stun.l.google.com:19302
STUN_SERVER_SECONDARY=stun:stun1.l.google.com:19302

# GitHub
GITHUB_USERNAME=your_github_username
GITHUB_TOKEN=ghp_your_github_token
GITHUB_REPO=your_repo_name
GITHUB_REPO_URL=https://github.com/your-org/your-repo

# Initial Admin Seed
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_EMAIL=your_admin_email@example.com
INITIAL_ADMIN_PASSWORD=your_initial_password
INITIAL_ADMIN_PIN=123456
